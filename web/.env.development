# Used only by `npm run dev` (vite dev server), talking directly to each
# service's own port on localhost — no gateway involved. When served via
# the nginx gateway container in docker-compose, these are baked in at
# build time instead (see services/gateway/Dockerfile build args) and
# default to same-origin /api, /ws/chat, /ws/media.
VITE_AUTH_BASE_URL=http://localhost:4001
VITE_API_BASE_URL=http://localhost:4002
VITE_CHAT_WS_URL=http://localhost:4003
VITE_CHAT_WS_PATH=/socket.io
VITE_MEDIA_WS_URL=ws://localhost:4004/ws/media
