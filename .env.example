# Copy this file to .env at the repo root before running
# `docker compose -f infra/docker-compose.dev.yml up`.
# packages/config validates these at each service's startup and will
# crash immediately (loud, not silent) if a required var is missing.

# --- Shared secrets ---
# Any long random string works for local dev. Use different, longer,
# randomly generated secrets in any real deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please

# Shared secret for service-to-service calls (chat/media -> api-service
# /internal/* routes). NOT exposed through the gateway. Min 16 chars.
# Generate a real one with:  openssl rand -hex 32
INTERNAL_API_SECRET=dev-internal-secret-change-me-please

# --- Postgres ---
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming
# Individual services each get DATABASE_URL pointed at the same Postgres
# instance/database in docker-compose.dev.yml (Phase 1: one shared DB,
# logically-separate tables per service).

# --- Redis ---
# Wired automatically to the `redis` container in docker-compose.dev.yml.

# --- auth-service ---
AUTH_SERVICE_PORT=4001
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Google OAuth2 client ID used for "Continue with Google" sign-in. This is
# A dedicated OAuth client for this product (not LR21's — their shared
# client is flagged by Google as not using "secure OAuth flows", which
# silently blocks sign-in from any newly-added origin on it). Client IDs
# aren't secret, they're meant to be embedded in frontend code. The web
# app's domain must be added to this client's Authorized JavaScript
# origins in Google Cloud Console (APIs & Services -> Credentials) or
# sign-in will be rejected. No client secret is needed — the Google
# Identity Services ID-token flow this app uses is browser-only.
GOOGLE_CLIENT_ID=206166506938-3dr1b89rl2n8amjtor6naqua5diitd1l.apps.googleusercontent.com

# --- api-service ---
API_SERVICE_PORT=4002
# How chat-service / media-service reach api-service's internal endpoints
# (defaults to http://api-service:4002 inside the compose network).
API_SERVICE_INTERNAL_URL=http://api-service:4002

# --- Live streams: who may host ---
# A user may start a stream if ANY of: (a) their email is listed in
# STREAM_ADMIN_EMAILS, (b) they have an Elonix bot premium subscription
# (verified via the LR21 bridge below), (c) they have >= STREAM_MIN_FOLLOWERS
# followers on THIS platform (follower counts start at 0).
STREAM_MIN_FOLLOWERS=500
# Comma-separated, case-insensitive. Admins can host and moderate any stream.
STREAM_ADMIN_EMAILS=admin@example.com
# Elonix (LR21) premium bridge. Leave BOTH blank to disable (premium is then
# never granted; eligibility reports bridge: "not_configured").
# Calls: POST <URL> body {"email":"..."} with header
#   X-Internal-Signature: hex(HMAC-SHA256(body, LR21_BRIDGE_SECRET))
LR21_BRIDGE_URL=
# Generate with:  openssl rand -hex 32  (must match the LR21 side)
LR21_BRIDGE_SECRET=

# --- Capacity limits (protect the shared 4-CPU server) ---
# Counted per UNIQUE USER (two tabs of one user = 1). Invalid values crash
# the service at startup. Defaults shown.
# Max participants in a voice room; also the upper bound a channel owner may set.
VOICE_ROOM_MAX_PEERS=25
# Max unique users in a live stream room (the host and platform admins are always let in).
STREAM_ROOM_MAX_PEERS=150
# Max members of a private channel.
PRIVATE_CHANNEL_MAX_MEMBERS=200

# --- chat-service ---
CHAT_SERVICE_PORT=4003
# Rate limiting (Redis counters; fails open with an error log if Redis is down).
# At most CHAT_RATE_LIMIT_MESSAGES messages per user per window.
CHAT_RATE_LIMIT_MESSAGES=10
CHAT_RATE_LIMIT_WINDOW_SEC=10
# File uploads per user per minute (HTTP 429 + Retry-After when exceeded).
UPLOAD_RATE_LIMIT_PER_MINUTE=5

# --- media-service ---
MEDIA_SERVICE_PORT=4004
# Stream rooms: seconds a listener must wait after the host denies their request to speak.
SPEAK_REQUEST_COOLDOWN_SEC=10
# IP mediasoup announces in ICE candidates. For local docker-compose dev
# where the browser runs on the SAME machine as docker, 127.0.0.1 works.
# For testing from a second machine/device on your LAN, set this to your
# host machine's LAN IP (e.g. 192.168.1.42).
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- gateway ---
GATEWAY_PORT=8080
