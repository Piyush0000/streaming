# Copy this file to .env at the repo root before running
# `docker compose -f infra/docker-compose.dev.yml up`.
# packages/config validates these at each service's startup and will
# crash immediately (loud, not silent) if a required var is missing.

# --- Shared secrets ---
# Any long random string works for local dev. Use different, longer,
# randomly generated secrets in any real deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please

# --- Postgres ---
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming
# Individual services each get DATABASE_URL pointed at the same Postgres
# instance/database in docker-compose.dev.yml (Phase 1: one shared DB,
# logically-separate tables per service).

# --- Redis ---
# Wired automatically to the `redis` container in docker-compose.dev.yml.

# --- auth-service ---
AUTH_SERVICE_PORT=4001
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Google OAuth2 client ID used for "Continue with Google" sign-in. This is
# A dedicated OAuth client for this product (not LR21's — their shared
# client is flagged by Google as not using "secure OAuth flows", which
# silently blocks sign-in from any newly-added origin on it). Client IDs
# aren't secret, they're meant to be embedded in frontend code. The web
# app's domain must be added to this client's Authorized JavaScript
# origins in Google Cloud Console (APIs & Services -> Credentials) or
# sign-in will be rejected. No client secret is needed — the Google
# Identity Services ID-token flow this app uses is browser-only.
GOOGLE_CLIENT_ID=206166506938-3dr1b89rl2n8amjtor6naqua5diitd1l.apps.googleusercontent.com

# --- api-service ---
API_SERVICE_PORT=4002

# --- chat-service ---
CHAT_SERVICE_PORT=4003

# --- media-service ---
MEDIA_SERVICE_PORT=4004
# IP mediasoup announces in ICE candidates. For local docker-compose dev
# where the browser runs on the SAME machine as docker, 127.0.0.1 works.
# For testing from a second machine/device on your LAN, set this to your
# host machine's LAN IP (e.g. 192.168.1.42).
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- gateway ---
GATEWAY_PORT=8080
